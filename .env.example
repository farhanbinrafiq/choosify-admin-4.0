# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3001"

# ── Database (REQUIRED — server throws at boot without this) ────────
# Postgres connection string. Users/auth/notifications/partner-applications/
# Choosify User IDs are read/written here via drizzle-orm. A separate beta
# database is created simply by pointing this at a different instance —
# no code changes required.
# DATABASE_URL="postgresql://user:password@host:5432/database_name"

# ── Auth token signing (REQUIRED — server throws at boot without JWT_ACCESS_SECRET) ─
# JWT_ACCESS_SECRET signs short-lived access tokens; JWT_REFRESH_SECRET peppers
# refresh-token hashes (falls back to an empty pepper if unset — set a real
# value for any non-local environment). Use long random strings, never reuse
# across environments.
# JWT_ACCESS_SECRET=""
# JWT_REFRESH_SECRET=""

# ── Application-owned media storage (pre-VPS self-hosting pass) ─────
# Core, no external provider required. MEDIA_STORAGE_ROOT is where uploaded
# files actually live — default is a local, gitignored `.data/media/` for
# dev only. On a VPS, set this to a real path on a persistent volume OUTSIDE
# the repo/build directory, e.g. /data/choosify/media, and back it up exactly
# like the database (see PRE-VPS SELF-HOSTING report for the full backup scope).
# MEDIA_STORAGE_ROOT="/data/choosify/media"
#
# MEDIA_PUBLIC_BASE_URL is the URL prefix the API returns for uploaded files
# and (for local dev) the path Express serves them from. Default "/media".
# On a VPS, point Nginx at MEDIA_STORAGE_ROOT under this same prefix so
# static file requests never hit Node.
# MEDIA_PUBLIC_BASE_URL="/media"
#
# MEDIA_STORAGE_PROVIDER: "local" (default, core) or "cloudinary" (optional,
# legacy — requires CLOUDINARY_* below). Leave unset/local for self-hosting.
# Never applies to private categories (verification/identity/seller/creator
# documents) — those are always stored locally regardless of this setting.
# MEDIA_STORAGE_PROVIDER="local"
#
# PRIVATE_STORAGE_ROOT: where sensitive documents (verification, identity,
# seller/creator business docs) live. NEVER static-mounted, NEVER a public
# URL — reachable only via the authenticated GET /catalog/media/private/:id
# route. Default is a local, gitignored `.data/private/` for dev. On a VPS,
# set this to a real path on the persistent volume, separate from
# MEDIA_STORAGE_ROOT, e.g. /data/choosify/private.
# PRIVATE_STORAGE_ROOT="/data/choosify/private"

# ── Provider-neutral SMTP (email verification, password reset, security notices) ─
# Unset SMTP_HOST = emails are logged to the console instead of sent, so
# local dev works without a real mail server. Any standard SMTP provider
# works — Hostinger's own mail, a transactional-email provider's SMTP relay,
# a self-hosted Postfix — application code never references a specific one.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="Choosify <no-reply@choosify.bd>"
# SMTP_SECURE="false"

# Local dev port (Choosify-Web uses 3000)
PORT=3001

# Application metadata
NODE_ENV=development
APP_NAME="Choosify Admin"
APP_VERSION="0.0.0"

# Comma-separated allowed browser origins for API + Socket.IO CORS
# Local defaults: http://localhost:3000 (storefront), http://localhost:3001 (admin)
# Production example:
# ALLOWED_ORIGINS="https://choosify.bd,https://www.choosify.bd,https://dashboard.choosify.bd"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# ── Media uploads: Cloudinary (OPTIONAL — see MEDIA_STORAGE_PROVIDER above) ──
# Uploads work with none of these set at all — they go to application-owned
# local storage instead. Only set these (and MEDIA_STORAGE_PROVIDER=cloudinary)
# if you deliberately want to keep using Cloudinary as the storage backend.
# VITE_CLOUDINARY_CLOUD_NAME=""
# VITE_CLOUDINARY_UPLOAD_PRESET=""
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""

# Firebase Admin (optional — without this, omni messaging uses in-memory store)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
# FIRESTORE_DATABASE_ID="ai-studio-c2303f92-945b-405b-9b0b-230b63fef478"

# ── Omni-channel messaging ──────────────────────────────────────────
# mock = inbox works locally, replies stay in Choosify only
# live = deliver via Meta Graph API (requires credentials below)
MESSAGING_MODE=mock

META_VERIFY_TOKEN=choosify_omni_secure_token_abc123
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=

WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Public URL Meta will call for webhooks (set when deployed)
WEBHOOK_PUBLIC_URL=

# ── Catalog API (CMS → storefront sync) ─────────────────────────────
# false = in-memory catalog (resets on server restart)
# true = persist to Firestore (requires Firebase Admin credentials above)
CATALOG_USE_FIRESTORE=false

# Operations API persistence (orders, reviews, leads, coupons, shipments, flags)
OPERATIONS_USE_FIRESTORE=false

# Auth: mock = role picker fallback; live = Firebase email/password + /auth/me role lookup
VITE_AUTH_MODE=mock
# Dev-only /auth/dev-login route requires BOTH this flag AND NODE_ENV!=="production".
# Defaults to false so a fresh environment is safe out of the box.
ALLOW_DEV_LOGIN=false

# Admin CMS catalog API base (used by admin UI)
VITE_API_BASE_URL="/api/v1"

# Published Choosify-Web origin (Website Manager → Preview Website). No trailing slash.
# Local: http://localhost:5173   Production fallback in code: https://choosify.bd
# VITE_CHOOSIFY_WEB_URL=http://localhost:5173

# Live Preview iframe origin (real storefront, not a mock). Defaults to VITE_CHOOSIFY_WEB_URL.
# VITE_CHOOSIFY_WEB_PREVIEW_URL=http://localhost:5173

# ── Security hardening (ES-005) ─────────────────────────────────────
# Rate limiting window (milliseconds) and per-policy max requests per window
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_HEALTH_MAX=120
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PUBLIC_MAX=300
RATE_LIMIT_CATALOG_READ_MAX=600
RATE_LIMIT_SEARCH_MAX=120
RATE_LIMIT_MESSAGING_MAX=100
RATE_LIMIT_ADMIN_MAX=200

# Request body size limits (supports express bytes format, e.g. 1mb, 256kb)
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
RAW_BODY_LIMIT=256kb

# Base64 image upload max decoded size (bytes)
UPLOAD_MAX_BYTES=5242880

# Abuse protection thresholds (in-memory; no persistence)
ABUSE_FAILED_AUTH_WINDOW_MS=900000
ABUSE_FAILED_AUTH_THRESHOLD=20
ABUSE_SUSPICIOUS_WINDOW_MS=900000
ABUSE_SUSPICIOUS_THRESHOLD=200

# ── Marketplace analytics (ES-008) ──────────────────────────────────
# In-memory event retention cap. Future production storage should use analytics_events.
ANALYTICS_MAX_IN_MEMORY_EVENTS=25000

# ── Emi AI Platform (ES-012) ──────────────────────────────────────────
AI_ENABLED=true
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
AI_TIMEOUT_MS=30000
AI_RETRIES=2
AI_MAX_INPUT_CHARS=12000
AI_FEATURE_CHAT=true
AI_FEATURE_RECOMMEND=true
AI_FEATURE_SUMMARIZE=true
AI_FEATURE_COMPARE=true
AI_FEATURE_EXPLAIN=true
AI_FEATURE_CLASSIFY=true
AI_FEATURE_MODERATE=true
RATE_LIMIT_AI_MAX=60
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_LOCAL_ENDPOINT=

# ── Payments (SSLCommerz) ────────────────────────────────────────────
# Unset (or empty) = checkout offers COD + a clearly-labeled "Test Mode"
# prepay option only; the real online-payment button is hidden until both
# STORE_ID and STORE_PASSWORD are set. Set SSLCOMMERZ_MODE=live only with
# real production credentials in a production environment.
# SSLCOMMERZ_MODE=sandbox
# SSLCOMMERZ_STORE_ID=
# SSLCOMMERZ_STORE_PASSWORD=

# ── Scheduled jobs ───────────────────────────────────────────────────
# Shared secret checked by the booking-expiry cron endpoint (POST, called on
# a schedule — vercel.json runs it every 15 min on Vercel; any other host
# needs an equivalent external scheduler hitting the same endpoint with this
# header/secret).
# CRON_SECRET=

# ── Local dev conveniences ───────────────────────────────────────────
# Password used by the dev-seeded admin/staff/test accounts and by every
# npm run test:* probe script. Dev-environment only — irrelevant once
# ALLOW_DEV_LOGIN=false and real accounts are used.
# DEV_SEED_PASSWORD=

# Optional overrides for the memory+disk-snapshot persistence files (operations
# store, booking-request store, communication broadcasts/preferences). Default
# to .data/<domain>-memory-snapshot.json under the working directory when
# unset — override only if you need those files somewhere else (e.g. a
# mounted persistent volume in a container deployment).
# OPERATIONS_MEMORY_SNAPSHOT_PATH=
# BOOKING_MEMORY_SNAPSHOT_PATH=
# COMMUNICATION_MEMORY_SNAPSHOT_PATH=
